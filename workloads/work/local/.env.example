# ==============================================================================
# Variables de Entorno para la Pila Local de Desarrolladores
# Copiar este archivo a .env antes de levantar: cp .env.example .env
# ==============================================================================

# PostgreSQL
POSTGRES_DB=app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO (S3 Compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit (Email Mock)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
